# ── Express API ───────────────────────────────────────────────────────────────
PORT=5000

# ── Database (SQL engine TBD – agreed with Vaibhav on Day 1) ─────────────────
# Leave as placeholder until Vaibhav confirms PostgreSQL or MySQL.
# DATABASE_URL=replace_me

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=15m

# ── CORS (comma-separated origins for multi-origin support) ───────────────────
CORS_ORIGIN=http://localhost:5173

# ── Biometric service (payload contract TBD – agreed with Shree Sai) ─────────
# Internal only – never expose to browser.
BIOMETRIC_SERVICE_URL=http://127.0.0.1:8000
BIOMETRIC_THRESHOLD=0.60

# ── File upload ───────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=5242880
