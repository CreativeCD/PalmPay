# ==============================================================================
# PalmPay — Root Environment Configuration Reference
# ==============================================================================
# This file provides an overview of the environment variables used across
# all services in the PalmPay repository.
#
# Copy the service-specific .env.example into each service folder:
#   cp backend/.env.example backend/.env
#   cp biometric/.env.example biometric/.env
#   cp frontend/.env.example frontend/.env
# ==============================================================================

# ── Backend (Express API) ─────────────────────────────────────────────────────
# Port for the Node.js Express server
PORT=5000

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/palmpay

# Long, random secret key for JWT signing (minimum 32 characters)
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=15m

# Internal URL where the Python FastAPI biometric microservice is running
BIOMETRIC_SERVICE_URL=http://127.0.0.1:8000

# Minimum cosine similarity score required for payment authorization (0.0 to 1.0)
BIOMETRIC_THRESHOLD=0.60

# Upload limits and security
MAX_UPLOAD_BYTES=5242880
BCRYPT_ROUNDS=12

# Allowed CORS origins (comma-separated or single URL)
CORS_ORIGIN=http://localhost:5173

# ── Biometric Microservice (FastAPI + OpenCV) ─────────────────────────────────
# Port for the Python biometric microservice (internal only)
BIOMETRIC_PORT=8000

# ── Frontend (React + Vite) ───────────────────────────────────────────────────
# Base URL for API requests (in dev, Vite proxies /api to http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000
