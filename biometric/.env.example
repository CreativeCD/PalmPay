# PalmPay Biometric Microservice
# ─────────────────────────────────────────────────────────────────────────────
# This service processes NIR palm images and returns similarity scores ONLY.
# It does NOT connect to the database.
# It does NOT make payment or authorization decisions.
# The matching threshold lives exclusively in the Express backend (.env there).
# ─────────────────────────────────────────────────────────────────────────────

PORT=8000

# Similarity score direction: higher = more similar (cosine similarity of HOG vectors)
# SIMILARITY_SCORE_DIRECTION=higher_is_better
